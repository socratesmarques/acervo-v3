DATABASE_URL=postgresql://acervo:change-this@localhost:5432/acervo
APP_ORIGIN=http://localhost:5173
PORT=3001
COOKIE_SECURE=false
TRUST_PROXY=false
STORAGE_DIR=./storage
STORAGE_DRIVER=local
MAX_UPLOAD_MB=10240
FFMPEG_TIMEOUT_SECONDS=14400
# Somente para o comando npm run admin; remova a senha após criar a conta.
ADMIN_NAME=Sócrates
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Ao usar S3/R2, mantenha o bucket PRIVADO.
# S3_BUCKET=acervo
# S3_REGION=auto
# S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
