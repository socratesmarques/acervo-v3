# Execute node scripts/setup.mjs para gerar .env com senhas aleatórias.
POSTGRES_PASSWORD=
ADMIN_NAME=Sócrates
ADMIN_EMAIL=admin@acervo.local
ADMIN_PASSWORD=
APP_ORIGIN=http://localhost:8080
WEB_PORT=8080
BIND_ADDRESS=127.0.0.1
COOKIE_SECURE=false
STORAGE_DRIVER=local
MAX_UPLOAD_MB=10240
FFMPEG_TIMEOUT_SECONDS=14400
# Configuração opcional S3/R2, bucket privado:
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
